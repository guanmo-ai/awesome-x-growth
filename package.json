{
  "name": "awesome-x-growth",
  "version": "0.1.0",
  "private": true,
  "description": "有出处的推特运营与涨粉中文学习资料库",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/serve.mjs --dist",
    "start": "node scripts/serve.mjs --dist",
    "build": "node scripts/build.mjs",
    "build:preview": "node scripts/build.mjs --preview",
    "dev:preview": "node scripts/serve.mjs --preview",
    "check": "node scripts/build.mjs --check",
    "check:release": "node scripts/check-release.mjs",
    "check:repo": "node scripts/check-repo.mjs",
    "test": "node --test tests/*.test.mjs",
    "predev": "npm run build",
    "prestart": "npm run build",
    "predev:preview": "npm run build:preview"
  }
